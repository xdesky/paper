PPM_DATA_DIR=.data
PPM_JOB_TIMEOUT=180
PPM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set HTTPS public origin for deployment (Secure session cookies).
PPM_PUBLIC_URL=http://127.0.0.1:8000
# Provisional Starter allowance; Lifetime accounts have no project-count cap.
PPM_FREE_PROJECT_LIMIT=3
# Optional Stripe one-time checkout. Leave blank to disable purchases.
STRIPE_SECRET_KEY=
STRIPE_LIFETIME_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
