{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Papercraft Engine v1.2 Locked Model Spec",
  "type": "object",
  "required": [
    "schema_version",
    "model_id",
    "version",
    "locked",
    "units",
    "paper",
    "geometry_sha256",
    "geometry",
    "print_units",
    "sheet_count",
    "physical_assembly"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "model_id": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "const": "1.2.0"
    },
    "locked": {
      "const": true
    },
    "units": {
      "const": "mm"
    },
    "paper": {
      "type": "object",
      "required": [
        "name",
        "page_mm",
        "scale",
        "printable_body_mm",
        "tab_depth_mm"
      ],
      "properties": {
        "name": {
          "enum": [
            "US Letter",
            "A4"
          ]
        },
        "page_mm": {
          "enum": [
            [
              215.9,
              279.4
            ],
            [
              210,
              297
            ]
          ]
        },
        "scale": {
          "const": 1.0
        },
        "printable_body_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "tab_depth_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "US Letter"
              }
            }
          },
          "then": {
            "properties": {
              "page_mm": {
                "const": [
                  215.9,
                  279.4
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "A4"
              }
            }
          },
          "then": {
            "properties": {
              "page_mm": {
                "const": [
                  210,
                  297
                ]
              }
            }
          }
        }
      ]
    },
    "geometry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "geometry": {
      "type": "object",
      "required": [
        "model",
        "panels",
        "seams"
      ],
      "properties": {
        "model": {
          "type": "object"
        },
        "panels": {
          "type": "array",
          "minItems": 1
        },
        "seams": {
          "type": "array"
        }
      }
    },
    "unfold_strategy": {
      "type": "string"
    },
    "sheet_count": {
      "type": "integer",
      "minimum": 1
    },
    "physical_assembly": {
      "enum": [
        "NOT_TESTED",
        "TESTED",
        "FAILED"
      ]
    },
    "print_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "panel_ids",
          "sheet_number",
          "fold_code",
          "orientation_degrees",
          "bounds_mm"
        ],
        "properties": {
          "panel_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "sheet_number": {
            "type": "integer",
            "minimum": 1
          },
          "fold_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "orientation_degrees": {
            "type": "integer",
            "enum": [
              0,
              90
            ]
          },
          "bounds_mm": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}
